# Sabonea : réglages du serveur (Docker).
# « bash deploy.sh » en fait le fichier .env et remplit les valeurs marquées « Automatique » (voir DEPLOIEMENT.md).
# Ce fichier .env contient des mots de passe : il ne doit jamais être commité.

APP_NAME=Sabonea
APP_ENV=production
# Automatique (à la main : docker compose run --rm --no-deps app php artisan key:generate --show)
APP_KEY=
APP_DEBUG=false

# Automatique : adresse du site telle que les visiteurs la tapent.
# Sans domaine : http://ADRESSE_IP_DU_SERVEUR   —   avec domaine (bash deploy.sh --domain sabonea.com) : https://sabonea.com
APP_URL=http://ADRESSE_IP_DU_SERVEUR

# Adresse(s) servie(s) par Caddy (serveur web).
# Sans domaine : :80   —   avec domaine (HTTPS automatique) : sabonea.com, www.sabonea.com
SITE_ADDRESS=:80

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journal quotidien dans le volume storage (14 jours conservés).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base PostgreSQL du conteneur « db » (créée avec ces identifiants au premier démarrage).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sabonea
DB_USERNAME=sabonea
# Automatique (à la main : openssl rand -hex 24). Ne plus le changer une fois la base créée.
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Passer à true une fois le HTTPS actif (domaine configuré).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# E-mails : Microsoft 365 (contact@sabonea.com).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=contact@sabonea.com
# Demandé par deploy.sh : mot de passe de la boîte contact@sabonea.com
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="contact@sabonea.com"
MAIL_FROM_NAME="${APP_NAME}"

# Premier compte administrateur, pour une installation neuve seulement
# (php artisan db:seed) : inutile si vous importez vos données. Mot de passe automatique.
ADMIN_EMAIL=admin@sabonea.com
ADMIN_PASSWORD=
